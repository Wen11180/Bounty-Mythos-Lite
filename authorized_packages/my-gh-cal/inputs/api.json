{
  "openapi": "3.0.0",
  "info": {
    "title": "Local Cal.com booking controller modeling excerpt",
    "version": "local-research-only"
  },
  "paths": {
    "/local/cal/api/bookings/{id}": {
      "get": {
        "operationId": "get_local_cal_booking",
        "summary": "Retrieve booking after BookingAccessService organizer/host/team-admin check"
      }
    },
    "/local/cal/api/bookings/{id}/confirm": {
      "post": {
        "operationId": "confirm_local_cal_booking",
        "summary": "Confirm booking after doesUserIdHaveAccessToBooking"
      }
    },
    "/local/cal/api/bookings/{id}/location": {
      "patch": {
        "operationId": "edit_local_cal_booking_location",
        "summary": "Edit booking location after doesUserIdHaveAccessToBooking"
      }
    }
  }
}